# Load the tools pinned in mise.toml.
mise install

# Force the pre-commit gate for every developer. `mise run setup` does the
# same, and also syncs the Vale styles.
if git rev-parse --git-dir >/dev/null 2>&1; then
	hooks_dir="$(git rev-parse --git-path hooks)"
	if ! grep -qs pre-commit "$hooks_dir/pre-commit"; then
		log_status "installing pre-commit hooks"
		mise exec -- pre-commit install --install-hooks
	fi
fi
