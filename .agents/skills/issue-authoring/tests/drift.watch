.claude/skills
.github/ISSUE_TEMPLATE/
.github/labels.yml
.github/pull_request_template.md
.github/workflows/
.pre-commit-config.yaml
mise.toml
scripts/issue-new.sh
scripts/issue-scope-label.sh
