{
  "name": "lumino-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Throwaway spike: which of nine IDE-framework capabilities does Lumino give natively, and what must we write ourselves.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:jsdom": "vitest run --project jsdom",
    "test:browser": "vitest run --project browser",
    "demo": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "@lumino/application": "2.4.11",
    "@lumino/commands": "2.3.4",
    "@lumino/coreutils": "2.2.3",
    "@lumino/default-theme": "2.1.17",
    "@lumino/disposable": "2.1.6",
    "@lumino/messaging": "2.0.5",
    "@lumino/signaling": "2.1.6",
    "@lumino/widgets": "2.10.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "31.0.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
