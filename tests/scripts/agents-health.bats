#!/usr/bin/env bats

# scripts/agents-health.sh tells a developer whether this machine can run
# the agent workflow: decisionkit is installed, configured and working, and
# the pre-commit hook is installed. It reports every problem in one run, so
# the developer fixes them all at once. `mise run agents:health` calls it.

bats_require_minimum_version 1.5.0

load helpers/common

setup() {
	# A caller can inject git settings, such as core.hooksPath, through
	# GIT_CONFIG_* variables. This suite tests where the script looks for
	# the hook, so it starts without them.
	for v in $(compgen -v | grep '^GIT_CONFIG_'); do unset "$v"; done
	sandbox agents-health.sh
	S=scripts/agents-health.sh
	# Only the fakes and the system tools (git, grep) stay on PATH. A real
	# decisionkit of the developer cannot leak into a test.
	PATH="$BATS_TEST_TMPDIR/bin:/usr/bin:/bin"
	unset DECISIONKIT_PROVIDER
	HEALTHY_MESSAGE="All checks passed. The agent environment is healthy."
	UNHEALTHY_MESSAGE="Some checks failed. The agent environment is not healthy."
}

# Pass when the text $1 contains (has) or does not contain (lacks) the text
# $2. A bare [[ ]] cannot fail a test on bash 3.2 unless it is the last
# command, so every text check goes through these two functions.

# Write the pre-commit hook that `pre-commit install` creates.
install_hook() {
	fixture "${1:-.git/hooks}/pre-commit" <<'EOF'
#!/usr/bin/env bash
# File generated by pre-commit: https://pre-commit.com
exec pre-commit hook-impl
EOF
}

# A healthy machine: decisionkit works, a provider is set, the hook exists.
make_healthy() {
	fake_decisionkit
	export DECISIONKIT_PROVIDER=test-provider
	install_hook
}

@test "all checks pass: prints the healthy message and exits 0" {
	make_healthy
	run "$S"
	[ "$status" -eq 0 ]
	[ "$output" = "$HEALTHY_MESSAGE" ]
	[ "$(calls)" = "decisionkit status" ]
}

@test "a missing decisionkit fails and skips the status check" {
	make_healthy
	rm "$BATS_TEST_TMPDIR/bin/decisionkit"
	[ -z "$(command -v decisionkit)" ]
	run "$S"
	[ "$status" -eq 1 ]
	has "$output" "decisionkit is not installed. Run 'mise install'."
	lacks "$output" "decisionkit status failed"
	has "$output" "$UNHEALTHY_MESSAGE"
}

@test "an unset DECISIONKIT_PROVIDER fails" {
	make_healthy
	unset DECISIONKIT_PROVIDER
	run "$S"
	[ "$status" -eq 1 ]
	has "$output" "DECISIONKIT_PROVIDER is not set. Set it in mise.local.toml. See README.md."
	has "$output" "$UNHEALTHY_MESSAGE"
}

@test "an empty DECISIONKIT_PROVIDER fails like an unset one" {
	make_healthy
	export DECISIONKIT_PROVIDER=""
	run "$S"
	[ "$status" -eq 1 ]
	has "$output" "DECISIONKIT_PROVIDER is not set."
}

@test "a failing decisionkit status fails and hides the noise of decisionkit" {
	make_healthy
	dk_responder <<-'EOF'
		echo "noise on stdout"
		echo "noise on stderr" >&2
		exit 1
	EOF
	run "$S"
	[ "$status" -eq 1 ]
	has "$output" "decisionkit status failed. Run 'decisionkit status' for details."
	lacks "$output" "noise"
	[ "$(calls)" = "decisionkit status" ]
}

@test "a missing pre-commit hook fails" {
	make_healthy
	rm .git/hooks/pre-commit
	run "$S"
	[ "$status" -eq 1 ]
	has "$output" "The pre-commit hook is not installed. Run 'mise run setup'."
	has "$output" "$UNHEALTHY_MESSAGE"
}

@test "a hook that pre-commit did not write fails" {
	make_healthy
	fixture .git/hooks/pre-commit <<<$'#!/bin/sh\necho "my own hook"'
	run "$S"
	[ "$status" -eq 1 ]
	has "$output" "The pre-commit hook is not installed."
}

@test "the hook is found through core.hooksPath" {
	make_healthy
	rm .git/hooks/pre-commit
	install_hook .githooks
	git config core.hooksPath .githooks
	run "$S"
	[ "$status" -eq 0 ]
	[ "$output" = "$HEALTHY_MESSAGE" ]
}

@test "the hook is found from a linked worktree" {
	make_healthy
	git commit -q --allow-empty -m init
	git worktree add -q -b feature "$BATS_TEST_TMPDIR/wt"
	cd "$BATS_TEST_TMPDIR/wt"
	run "$SANDBOX/scripts/agents-health.sh"
	[ "$status" -eq 0 ]
	[ "$output" = "$HEALTHY_MESSAGE" ]
}

@test "every problem is reported in one run, on stderr, with one summary on stdout" {
	run --separate-stderr "$S"
	[ "$status" -eq 1 ]
	[ "$output" = "$UNHEALTHY_MESSAGE" ]
	has "$stderr" "decisionkit is not installed."
	has "$stderr" "DECISIONKIT_PROVIDER is not set."
	has "$stderr" "The pre-commit hook is not installed."
	lacks "$stderr" "decisionkit status failed"
}

@test "a failing status and a missing hook are both reported" {
	fake_decisionkit
	export DK_FAIL=1 DECISIONKIT_PROVIDER=test-provider
	run "$S"
	[ "$status" -eq 1 ]
	has "$output" "decisionkit status failed."
	has "$output" "The pre-commit hook is not installed."
	lacks "$output" "is not installed. Run 'mise install'"
	lacks "$output" "All checks passed."
}
